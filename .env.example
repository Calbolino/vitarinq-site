# ────────────────────────────────────────────────────────────
# VitaRinq — variables d'environnement (EXEMPLE / template public)
# Copie ce fichier en ".env" et remplis les vraies valeurs.
# Le vrai ".env" n'est PAS committé (voir .gitignore).
# Sur Replit (déploiement) : Tools → Secrets → ajoute les mêmes clés.
# ────────────────────────────────────────────────────────────

# Clé d'accès Web3Forms (réception des précommandes par email).
# Gratuite sur https://web3forms.com (entre ton email de réception).
WEB3FORMS_ACCESS_KEY=ta_cle_web3forms_ici

# ── Comment ça marche ──
# server.js lit ce .env (et les Secrets Replit, prioritaires) puis injecte
# la valeur dans le HTML à la place du jeton __WEB3FORMS_ACCESS_KEY__.
# Le déploiement est en "autoscale" (.replit) → server.js tourne en prod,
# donc la clé n'apparaît jamais dans le code committé.

# ── Futurs codes / clés API (décommente au besoin) ──
# STRIPE_PUBLIC_KEY=
# GA_MEASUREMENT_ID=
